# Copy to .env and fill in real values.
# Local dev (docker): docker run -d --name orderin-pg -e POSTGRES_USER=orderin \
#   -e POSTGRES_PASSWORD=orderin -e POSTGRES_DB=orderin -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://orderin:orderin@localhost:5433/orderin?schema=public"

# Admin session signing secret (HMAC-SHA256). MUST be a long random string in
# production — rotating it invalidates all admin sessions.
# SEC-05: in production the app REFUSES to start when SESSION_SECRET is missing
# or still the dev default. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Monetisation Phase 3 / T21 — Duitku billing (issue #257) ────────────────
# Server-only env vars — never exposed to the client bundle. Fill real values
# in Vercel env (production + preview); sandbox uses the sandbox base URL with
# a test merchant code (DXXXX). Docs: docs/MONETIZATION-PLAN-PHASE3.md §6.1

# Duitku merchant code (dashboard Duitku, format DXXXX).
DUITKU_MERCHANT_CODE=""
# Duitku API key — signs createInvoice requests AND verifies callbacks.
DUITKU_API_KEY=""
# Full create-invoice endpoint. Sandbox:
#   https://api-sandbox.duitku.com/api/merchant/createInvoice
# Prod:
#   https://api-prod.duitku.com/api/merchant/createInvoice
DUITKU_BASE_URL="https://api-sandbox.duitku.com/api/merchant/createInvoice"
# Secret for POST /api/cron/rebill (called by the GitHub Actions schedule
# workflow with header x-cron-secret). Generate with: openssl rand -base64 32
CRON_SECRET=""
# Public origin used for the Duitku callbackUrl + returnUrl (NOT a secret —
# the only NEXT_PUBLIC_* var).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
