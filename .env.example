# Copy to .env and fill in real values.
# Local dev (docker): docker run -d --name orderin-pg -e POSTGRES_USER=orderin \
#   -e POSTGRES_PASSWORD=orderin -e POSTGRES_DB=orderin -p 5433:5432 postgres:16-alpine
DATABASE_URL="postgresql://orderin:orderin@localhost:5433/orderin?schema=public"

# Admin session signing secret (HMAC-SHA256). MUST be a long random string in
# production — rotating it invalidates all admin sessions.
# SEC-05: in production the app REFUSES to start when SESSION_SECRET is missing
# or still the dev default. Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Monetisation Phase 3 / T14 — Xendit billing (issue #257) ────────────────
# Server-only env vars — never exposed to the client bundle. Fill real values
# in Vercel env (production + preview); test mode uses an xnd_development_ key.
# Docs: docs/MONETIZATION-PLAN-PHASE3.md §6.1

# Xendit API key (create invoices, server-side).
XENDIT_SECRET_KEY="xnd_development_..."
# Token from Xendit Dashboard → Settings → Webhooks. Verified constant-time
# against the webhook's x-callback-token header.
XENDIT_WEBHOOK_TOKEN=""
# API base. Defaults to https://api.xendit.co when unset.
XENDIT_BASE_URL="https://api.xendit.co"
# Secret for POST /api/cron/rebill (called by the GitHub Actions schedule
# workflow with header x-cron-secret). Generate with: openssl rand -base64 32
CRON_SECRET=""
# Public origin used for the Xendit success_redirect_url (NOT a secret —
# the only NEXT_PUBLIC_* var).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
