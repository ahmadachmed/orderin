// Prisma schema for orderin — multitenant coffee takeaway ordering SaaS.
// See docs/PLAN.md section 7 (Data Model) — shared schema + row-level isolation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  name            String
  address         String?
  phone           String?
  logoUrl         String?
  isOpen          Boolean  @default(true)
  isOpenOverrideUntil DateTime? // time-boxed toggle override — expires at next schedule boundary (#207)
  openTime        String   @default("07:00") // HH:mm UTC
  closeTime       String   @default("21:00") // HH:mm UTC
  timezone        String   @default("Asia/Makassar")
  maxQueueSize    Int      @default(20)
  prepTimeBuffer  Int      @default(0) // additional buffer minutes
  sprintDurationDays Int   @default(1) // sprint retention period in days
  qrisImageUrl    String? // QRIS image (uploaded by tenant)
  qrisCode        String? // QRIS code string (for display/copy)
  bankAccountNumber String? // Bank account number for manual transfer
  bankName        String? // Bank name (e.g. BCA, BRI, Mandiri)
  // Monetisation Phase 0 / T1 — plan billing fields (issue #229)
  plan            Plan    @default(FREE)
  planExpiresAt  DateTime? // null = no expiry (FREE) or not set yet
  isActive        Boolean  @default(true) // soft-disable toggle (T8 enforces 403)
  contactEmail    String?  // nullable for now — T3 makes it mandatory
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItems MenuItem[]
  orders    Order[]
  admins    TenantAdmin[]
  sprints   Sprint[]
  customers Customer[]
  payments  Payment[] // Monetisation Phase 3 / T13 — billing payments (issue #257)
}

model TenantAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  username     String
  passwordHash String
  createdAt    DateTime @default(now())

  @@unique([tenantId, username])
}

model MenuItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  category        String? // menu grouping — e.g. "Minuman", "Makanan", "Camilan" (T14-followup)
  price           Decimal  @db.Decimal(10, 2)
  imageUrl        String?
  prepTimeSeconds Int      @default(120) // estimated prep time per item
  isAvailable     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]

  @@index([tenantId])
}

model Order {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @db.Uuid
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  customerName       String
  customerPhone      String
  pickupCode         String         @default("")  // T16: 4-digit PIN for pickup verification
  customerId         String?        @db.Uuid      // T17: optional account binding
  customer           Customer?      @relation(fields: [customerId], references: [id])
  status             OrderStatus   @default(PENDING)
  etaSeconds         Int? // estimated ready time in seconds (from now)
  etaCalculatedAt    DateTime? // when ETA was last calculated
  paymentStatus      PaymentStatus @default(UNPAID) // payment tracking
  paidAt             DateTime? // when barista marked paid
  paymentMethod      PaymentMethod? // 'qris' | 'bank_transfer' | 'cash'
  customerTransferNote String? // customer marks "I have paid" + optional note (bank transfer)
  paymentClaimedAt   DateTime? // authoritative "I have paid" claim flag (issue #224)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  sprintId           String?       @db.Uuid

  items      OrderItem[]
  statusLogs OrderStatusLog[]
  sprint     Sprint?   @relation(fields: [sprintId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([customerPhone])
  @@index([customerId])
  @@index([sprintId])
}

model OrderItem {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String   @db.Uuid
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)

  @@unique([orderId, menuItemId])
}

model OrderStatusLog {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id])
  status        OrderStatus
  paymentStatus PaymentStatus? // set when the log records a payment event (issue #7)
  actorType     String?        // 'BARISTA' | 'CUSTOMER' — who performed the action (issue #7)
  actorName     String?        // barista username or customer name (issue #7)
  note          String?
  createdAt     DateTime       @default(now())

  @@index([orderId])
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  startAt   DateTime
  endAt     DateTime?
  status    SprintStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime     @default(now())

  orders    Order[]

  @@index([tenantId, status])
}

model Customer {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  phone        String
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  BREWING
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  qris
  bank_transfer
  cash
}

enum SprintStatus {
  OPEN
  CLOSED
}

enum Plan {
  FREE
  PRO
}

// ─────────────────────────────────────────────────────────────────────
// Monetisation Phase 3 / T13 — billing payments (issue #257).
// Plan doc: docs/MONETIZATION-PLAN-PHASE3.md §5.
//
// NOTE on naming: the plan doc calls this enum `PaymentStatus`, but that
// name is already taken by the ORDER payment enum (UNPAID/PAID) above.
// Renamed to `BillingPaymentStatus` to avoid the Prisma name collision —
// semantics are exactly as specced (PENDING/PAID/EXPIRED).
// ─────────────────────────────────────────────────────────────────────

enum BillingPaymentStatus {
  PENDING // invoice created at Xendit, awaiting payment
  PAID // invoice.paid webhook verified — PRO activated
  EXPIRED // invoice.expired webhook, or Xendit create-invoice failure
}

model Payment {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  xenditInvoiceId String?              @unique // set after create-invoice succeeds (webhook lookup key)
  externalId      String               @unique // idempotency key: pay_<tenantId>_<periodStart epochMs>
  amount          Decimal              @db.Decimal(12, 2) // always 99000 — webhook validates against this
  periodStart     DateTime             // start of the 30-day period this payment covers
  periodEnd       DateTime             // periodStart + 30 days
  status          BillingPaymentStatus @default(PENDING)
  paidAt          DateTime?
  paymentMethod   String?              // channel used by customer (qris, bca_va, ...)
  invoiceUrl      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, periodStart])
}
